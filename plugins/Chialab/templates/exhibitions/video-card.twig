<div class="card" data-type="{{ object.get('type') }}">
    <div class="video-embed">
        {% if object.get('provider_extra') and object.get('provider_extra')['html'] %}
            {{ object.get('provider_extra')['html']|raw }}
        {% elseif Media.hasStream(object) %}
            <video
                src="{{ object.get('media_url') }}"
                controls
                controlslist="nodownload noremoteplayback noplaybackrate"
                disablepictureinpicture
            ></video>
        {% else %}
            <div class="media-placeholder"></div>
        {% endif %}
    </div>
    {% if object.get('description') %}
        <div class="card-description">
            {{ object.get('description')|raw }}
        </div>
    {% endif %}
</div>
