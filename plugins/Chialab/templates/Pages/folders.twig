<header class="w-full">
    {{ element('claim')|raw }}
</header>

<main class="w-full">
    {{ element('folder-layout', { folder: object })|raw }}

    {% if Paginator.total() > 1 %}
        <div class="pagination mono row gap-s end mt-4">
            {% if Paginator.hasPrev() %}
                {{ Paginator.prev(__('previous'))|raw }}
            {% endif %}
            <span class="link--section">{{ Paginator.counter(__('page {{page}} of {{pages}}'))|raw }}</span>
            {% if Paginator.hasNext() %}
                {{ Paginator.next(__('next'))|raw }}
            {% endif %}
        </div>
    {% endif %}


    {% if object.get('body') is not empty %}
    <div class="row mt-4 bt-1 pt-4 gap-1">
        <div class="w-8 column serif f-3 body">
            {{ Text.renderBody(object, field|default('body'))|raw }}
        </div>
        <aside class="column w-4 aside f-s">
            {{ element('Articles/aside') }}
        </aside>
    </div>
    {% endif %}

</main>
