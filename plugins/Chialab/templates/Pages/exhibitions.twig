<exhibition-carousel
    class="w-full exhibition-carousel"
    data-url="{{ Url.build({ _name: 'pages:objects', _entity: object }) }}"
    data-page="{{ Paginator.current() }}"
    data-pages="{{ Paginator.total() }}"
>
    <div class="exhibition-item exhibition-item--text exhibition-item--title column gap-xs">
        <h1 class="m-0">{{ object.title|raw }}</h1>
        {% if object.get('description') is not empty %}
            <div>{{ object.description|striptags('<p><br>')|raw }}</div>
        {% endif %}
    </div>
    {{ element('exhibition-items', { items: items })|raw }}
</exhibition-carousel>
